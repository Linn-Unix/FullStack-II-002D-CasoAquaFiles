# Copia este archivo como .env y cambia los valores. El .env NO se sube a GitHub.
DB_URL=jdbc:mysql://localhost:3306/aquafiles?serverTimezone=America/Santiago&allowPublicKeyRetrieval=true&useSSL=false
DB_USUARIO=aquafiles
DB_CLAVE=cambia_esta_clave

# Clave para firmar los tokens JWT (mínimo 32 caracteres)
JWT_SECRETO=escribe-aqui-una-clave-larga-de-al-menos-32-caracteres

# URL del frontend (sin / al final)
CORS_ORIGENES=http://localhost:5173

# Directorio local donde se guardan los archivos cargados
ARCHIVOS_DIRECTORIO=uploads

# Apoyo de IA con Grok (xAI). Crea la clave en https://console.x.ai. Sin clave, la IA queda desactivada.
GROK_API_KEY=
GROK_MODELO=grok-3-mini