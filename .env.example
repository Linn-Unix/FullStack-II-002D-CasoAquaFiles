# Copia este archivo como .env.local para desarrollo local.
VITE_API_URL=http://localhost:8080/api/v1

# ID de cliente OAuth de Google (Google Cloud Console → Credenciales → ID de cliente de OAuth, tipo "Aplicación web").
# Agrega http://localhost:5173 y la URL de Vercel en "Orígenes de JavaScript autorizados".
VITE_GOOGLE_CLIENT_ID=
